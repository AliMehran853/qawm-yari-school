# ═══════════════════════════════════════════
#   مکتب قوم یاری — .gitignore
# ═══════════════════════════════════════════

# ─── Dependencies ───
node_modules
.pnp
.pnp.js
.yarn/cache
.yarn/install-state.gz

# ─── Production builds ───
dist
dist-ssr
build
out

# ─── Logs ───
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Environment (خیلی مهم) ───
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ─── Vite ───
.vite
*.local

# ─── PWA generated (خودکار ساخته می‌شوند) ───
dev-dist
sw.js
workbox-*.js
workbox-*.js.map
manifest.webmanifest
registerSW.js
precache-manifest.*.js

# ─── Editor / IDE ───
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ─── OS ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Vercel ───
.vercel

# ─── Backup files ───
*.bak
*.backup
backups/
qawm-yari-backups/

# ─── Temporary files ───
*.tmp
*.temp
.cache
.temp

# ─── فایل‌های حساس ───
qawm-yari-secrets.txt
secrets.txt
passwords.txt